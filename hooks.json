{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "afplay /System/Library/Sounds/Glass.aiff 2>/dev/null || true # claude-config:sound",
          "async": true
        }
      ]
    }
  ],
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "afplay /System/Library/Sounds/Funk.aiff 2>/dev/null || true # claude-config:sound",
          "async": true
        }
      ]
    }
  ]
}
