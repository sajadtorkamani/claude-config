{
  "Stop": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/bin/notify.sh\" finished # claude-config:notify",
          "async": true
        }
      ]
    }
  ],
  "Notification": [
    {
      "hooks": [
        {
          "type": "command",
          "command": "\"$HOME/.claude/bin/notify.sh\" input # claude-config:notify",
          "async": true
        }
      ]
    }
  ]
}
